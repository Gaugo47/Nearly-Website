# Configuration PUBLIQUE, visible dans le code et le HTML du site. Aucun secret ici.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://hellonearly.com
# Facultatif : URL HTTPS de production du webhook PUBLIC n8n nearly-waitlist-public.
NEXT_PUBLIC_WAITLIST_API_URL=
# Clé de site PUBLIQUE Turnstile. Le secret reste dans les identifiants n8n.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# À compléter avant une publication publique. L’inscription reste désactivée tant que ces champs sont vides.
NEXT_PUBLIC_PUBLISHER_NAME=
NEXT_PUBLIC_PUBLISHER_STATUS=
NEXT_PUBLIC_PUBLISHER_SIRET=
NEXT_PUBLIC_PUBLISHER_ADDRESS=
NEXT_PUBLIC_PUBLICATION_DIRECTOR=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WAITLIST_HOST=
